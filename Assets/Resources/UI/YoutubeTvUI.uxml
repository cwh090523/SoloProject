            <ui:Label name="YoutubeTvMessageLabel" text="Paste a YouTube URL or video ID." style="height: 28px; color: rgba(255, 255, 255, 0.72); font-size: 14px;"/>
            <ui:VisualElement style="height: 48px; flex-direction: row; margin-top: 14px;">
                <ui:Button name="YoutubePlayButton" text="PLAY" style="flex-grow: 1; margin-right: 6px; color: rgb(255, 255, 255); font-size: 21px; -unity-font-style: bold; background-color: rgb(148, 20, 28); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;"/>
                <ui:Button name="YoutubeCloseButton" text="CLOSE" style="width: 180px; margin-left: 6px; color: rgb(255, 255, 255); font-size: 21px; -unity-font-style: bold; background-color: rgb(26, 54, 84); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;"/>
