<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="YoutubeTvRoot" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.42); -unity-font-definition: url(&quot;project://database/Assets/Front/x12y12pxMaruMinyaHangul.ttf?fileID=12800000&amp;guid=19cee556673267946ab7b6b20e34afe3&amp;type=3#x12y12pxMaruMinyaHangul&quot;);">
        <ui:VisualElement style="width: 620px; padding-left: 24px; padding-right: 24px; padding-top: 22px; padding-bottom: 22px; background-color: rgba(8, 10, 14, 0.96); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 214, 90, 0.55); border-right-color: rgba(0, 0, 0, 0.75); border-top-color: rgba(255, 214, 90, 0.55); border-bottom-color: rgba(0, 0, 0, 0.85); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px;">
            <ui:VisualElement style="height: 50px; flex-direction: row; justify-content: space-between; align-items: center;">
                <ui:Label text="SECRET TV" style="color: rgb(255, 255, 255); font-size: 34px; -unity-font-style: bold;"/>
