<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="GameResultContainer" picking-mode="Position" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.62); -unity-font-definition: url(&quot;project://database/Assets/Front/x12y12pxMaruMinyaHangul%20SDF%202.asset?fileID=11400000&amp;guid=a092c556b31066b459641e4b698c3373&amp;type=2#x12y12pxMaruMinyaHangul SDF 2&quot;);">
        <ui:VisualElement name="ResultPanel" style="width: 640px; min-height: 430px; padding-left: 30px; padding-right: 30px; padding-top: 26px; padding-bottom: 28px; background-color: rgba(10, 12, 16, 0.92); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.18); border-right-color: rgba(0, 0, 0, 0.6); border-top-color: rgba(255, 255, 255, 0.18); border-bottom-color: rgba(0, 0, 0, 0.75);">
            <ui:VisualElement name="ResultHeader" style="height: 126px; justify-content: center; align-items: center;">
                <ui:Label text="GAME OVER" name="ResultTitleLabel" style="color: rgb(255, 70, 62); font-size: 66px; -unity-font-style: bold; -unity-text-align: middle-center; -unity-text-outline-width: 2px; -unity-text-outline-color: rgba(0, 0, 0, 0.88);"/>
                <ui:Label text="SURVIVAL FAILED" name="ResultSubtitleLabel" style="margin-top: 8px; color: rgb(255, 214, 90); font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ResultDivider" style="height: 2px; margin-top: 8px; margin-bottom: 20px; background-color: rgba(255, 255, 255, 0.22);"/>
            <ui:VisualElement name="ResultStats" style="height: 138px;">
                <ui:VisualElement name="WaveRow" style="height: 40px; margin-bottom: 9px; padding-left: 16px; padding-right: 16px; flex-direction: row; align-items: center; justify-content: space-between; background-color: rgba(28, 48, 72, 0.82); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                    <ui:Label text="WAVE" style="color: rgba(255, 255, 255, 0.72); font-size: 18px; -unity-font-style: bold;"/>
                    <ui:Label text="1 / 20" name="ResultWaveLabel" style="color: rgb(255, 255, 255); font-size: 27px; -unity-font-style: bold; -unity-text-align: middle-right;"/>
                </ui:VisualElement>
                <ui:VisualElement name="KillRow" style="height: 40px; margin-bottom: 9px; padding-left: 16px; padding-right: 16px; flex-direction: row; align-items: center; justify-content: space-between; background-color: rgba(120, 0, 0, 0.78); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                    <ui:Label text="ENEMY KILL" style="color: rgba(255, 255, 255, 0.72); font-size: 18px; -unity-font-style: bold;"/>
                    <ui:Label text="0" name="ResultKillLabel" style="color: rgb(255, 255, 255); font-size: 27px; -unity-font-style: bold; -unity-text-align: middle-right;"/>
                </ui:VisualElement>
                <ui:VisualElement name="TimeRow" style="height: 40px; padding-left: 16px; padding-right: 16px; flex-direction: row; align-items: center; justify-content: space-between; background-color: rgba(48, 38, 12, 0.84); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                    <ui:Label text="SURVIVAL TIME" style="color: rgba(255, 255, 255, 0.72); font-size: 18px; -unity-font-style: bold;"/>
                    <ui:Label text="00:00" name="ResultTimeLabel" style="color: rgb(255, 255, 255); font-size: 27px; -unity-font-style: bold; -unity-text-align: middle-right;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ResultMessageBox" style="height: 52px; margin-top: 18px; margin-bottom: 22px; align-items: center; justify-content: center; background-color: rgba(255, 255, 255, 0.08); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px;">
                <ui:Label text="Prepare, reload, and try again." name="ResultMessageLabel" style="color: rgba(255, 255, 255, 0.82); font-size: 19px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ResultButtons" style="height: 54px; flex-direction: row; justify-content: space-between;">
                <ui:Button text="RESTART" name="RestartButton" style="width: 282px; height: 54px; color: rgb(255, 255, 255); font-size: 23px; -unity-font-style: bold; background-color: rgb(148, 20, 28); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;"/>
                <ui:Button text="TITLE" name="TitleButton" style="width: 282px; height: 54px; color: rgb(255, 255, 255); font-size: 23px; -unity-font-style: bold; background-color: rgb(26, 54, 84); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
