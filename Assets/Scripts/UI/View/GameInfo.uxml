<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="GameProgressInfo" style="position: absolute; top: 28px; left: 50%; margin-left: -280px; width: 560px; min-height: 124px; padding-top: 12px; padding-right: 16px; padding-bottom: 14px; padding-left: 16px; background-color: rgba(24, 19, 15, 0.78); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(176, 124, 62, 0.5); border-right-color: rgba(47, 32, 22, 0.9); border-top-color: rgba(232, 190, 112, 0.42); border-bottom-color: rgba(0, 0, 0, 0.72); -unity-font: url(&quot;project://database/Assets/Front/x12y12pxMaruMinyaHangul.ttf?fileID=12800000&amp;guid=19cee556673267946ab7b6b20e34afe3&amp;type=3#x12y12pxMaruMinyaHangul&quot;); -unity-font-definition: url(&quot;project://database/Assets/Front/x12y12pxMaruMinyaHangul.ttf?fileID=12800000&amp;guid=19cee556673267946ab7b6b20e34afe3&amp;type=3#x12y12pxMaruMinyaHangul&quot;);">
        <ui:VisualElement name="HeaderRow" style="height: 52px; flex-direction: row; align-items: center; justify-content: space-between;">
            <ui:Label text="WAVE 1 / 4" name="WaveLabel" style="color: rgb(250, 236, 205); font-size: 40px; -unity-font-style: bold; -unity-text-align: middle-left; min-width: 330px; width: 330px;"/>
            <ui:Label text="IN PROGRESS" name="StateLabel" style="color: rgb(226, 168, 73); font-size: 18px; -unity-font-style: bold; -unity-text-align: middle-right; -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(0, 0, 0, 0.75);"/>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="height: 2px; margin-top: 4px; margin-bottom: 10px; background-color: rgba(226, 168, 73, 0.34);"/>
        <ui:VisualElement name="InfoRow" style="height: 42px; flex-direction: row; align-items: stretch; justify-content: space-between;">
            <ui:VisualElement name="EnemyPanel" style="width: 254px; padding-left: 14px; padding-right: 14px; background-color: rgba(111, 35, 31, 0.86); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; flex-direction: row; align-items: center; justify-content: space-between;">
                <ui:Label text="ENEMY" style="color: rgba(255, 255, 255, 0.78); font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-left;"/>
                <ui:Label text="0 / 0" name="EnemyCountLabel" style="color: rgb(255, 255, 255); font-size: 26px; -unity-font-style: bold; -unity-text-align: middle-right;"/>
            </ui:VisualElement>
            <ui:VisualElement name="TimerPanel" style="width: 254px; padding-left: 14px; padding-right: 14px; background-color: rgba(24, 49, 67, 0.88); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px; flex-direction: row; align-items: center; justify-content: space-between;">
                <ui:Label text="NEXT" style="color: rgba(255, 255, 255, 0.78); font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-left;"/>
                <ui:Label text="00:00" name="TimerLabel" style="color: rgb(255, 255, 255); font-size: 26px; -unity-font-style: bold; -unity-text-align: middle-right;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="NEXT WAVE NOW" name="SkipRestockButton" style="display: none; height: 36px; margin-top: 9px; color: rgb(250, 236, 205); font-size: 17px; -unity-font-style: bold; background-color: rgb(122, 39, 34); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(232, 190, 112, 0.36); border-right-color: rgba(0, 0, 0, 0.62); border-top-color: rgba(232, 190, 112, 0.36); border-bottom-color: rgba(0, 0, 0, 0.72); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-right-radius: 2px; border-bottom-left-radius: 2px;"/>
    </ui:VisualElement>
</ui:UXML>
